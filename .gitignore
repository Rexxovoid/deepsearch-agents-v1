# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
/dist
/tmp
app/output
app/updated
app/data/
/out-tsc
# Only exists if Bazel was run
/bazel-out

# dependencies
/node_modules
frontend/node_modules/
frontend/dist/
frontend/.vite/
.pnpm-store/
.npm-cache
.angular/

# Python
.venv/
.uv-cache/
venv/
env/
.env
# Local configuration; publish only explicitly named example templates.
.env.*
!.env.example
!.env.*.example
.envexamples
.envexamples.*
*.local

# Runtime workspaces, databases and logs
/agent_workspace/
/output/
/updated/
# Personal knowledge-base material: keep locally, do not publish.
/docs/knowledge_base/
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.db
*.db-*
*.log

# Compiler/test/tool caches
*.tsbuildinfo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Local credentials and ad-hoc diagnostic files
.aws/
.ssh/
*.pem
*.key
/.task_*
/.ragflow-test-results.txt
__pycache__/
*.py[cod]
*$py.class
*.pyc

# profiling files
chrome-profiler-events*.json
speed-measure-plugin*.json

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# misc
/.angular/cache
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
