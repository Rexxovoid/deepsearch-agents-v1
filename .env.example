# Copy to .env and fill in your own credentials. Never commit .env.

# OpenAI-compatible model service
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=your-api-key
LLM_QWEN_MAX=your-model-name

# Public web search
TAVILY_API_KEY=your-tavily-api-key

# RAGFlow
RAGFLOW_API_URL=http://localhost:9380
RAGFLOW_API_KEY=your-ragflow-api-key
RAGFLOW_TIMEOUT_SECONDS=60

# MySQL: match your local Docker/database configuration
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-local-password
MYSQL_DATABASE=deepsearch_db
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL
MYSQL_ALLOWED_TABLES=drugs,inventory,sales_records
MYSQL_QUERY_TIMEOUT_SECONDS=10
MYSQL_MAX_ROWS=1000

# Account cookies / browser origins; use HTTPS and COOKIE_SECURE=1 in deployment
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=0
